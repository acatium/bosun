{
  "mcpServers": {
    "bosun-gateway": {
      "type": "stdio",
      "command": "gateway/.venv/bin/python",
      "args": [
        "gateway/bosun_gateway.py"
      ],
      "env": {
        "BOSUN_FABRIC_WORKSPACE_ID": "${BOSUN_FABRIC_WORKSPACE_ID}",
        "BOSUN_DATA_AGENT_ID": "${BOSUN_DATA_AGENT_ID}"
      }
    }
  }
}
