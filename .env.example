# Environment-specific settings for bootstrap. Copy to .env (which is gitignored) and fill in.
# Nothing here is a secret: GitHub Actions signs in to Azure by federation, so there are no keys.
# Bootstrap copies these values into GitHub repository variables for the pipeline.

# Which firm profile to use: config/profiles/<FIRM_PROFILE>.yaml
FIRM_PROFILE=contoso

# Leave blank to use the tenant and subscription you sign in to.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-contoso-demo
DEPLOYER_APP_NAME=contoso-deployer

# The GitHub organization and repository this copy of the platform lives in.
GITHUB_OWNER=
GITHUB_REPO=
